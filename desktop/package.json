{
  "name": "karaoke-punch",
  "productName": "Karaoke Punch",
  "version": "1.8.4",
  "description": "Караоке-студия с удалением вокала нейросетью",
  "main": "main.js",
  "author": "Gyros-dev",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --x64 --arm64",
    "dist": "electron-builder --mac --arm64 --win --x64 --arm64",
    "sync": "node sync-renderer.js",
    "postinstall": "node fix-electron.js && node setup-ort.js && node setup-transformers.js",
    "setup": "node setup-ort.js && node setup-transformers.js",
    "fix": "node fix-electron.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "@huggingface/transformers": "^4.2.0",
    "onnxruntime-web": "^1.27.0"
  },
  "build": {
    "appId": "dev.gyros.benengskaya",
    "productName": "Karaoke Punch",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": null,
      "icon": "build/icon.icns",
      "artifactName": "Karaoke-Punch-${version}-macOS-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Karaoke-Punch-${version}-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterPack": "build/afterPack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "Gyros-dev",
        "repo": "karaoke-maker"
      }
    ],
    "artifactName": "Karaoke-Punch-${version}-${os}-${arch}.${ext}"
  }
}
