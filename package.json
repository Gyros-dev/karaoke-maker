{
  "name": "karaoke-punch-site",
  "version": "1.19.0",
  "description": "Караоке-студия: сайт и приложение для компьютера",
  "private": true,
  "license": "MIT",
  "scripts": {
    "serve": "python3 -m http.server 8765",
    "versions": "node bump-version.js",
    "icons": "node make-icons.js",
    "app:install": "npm --prefix desktop install",
    "app:sync": "npm --prefix desktop run sync",
    "app:start": "npm --prefix desktop start",
    "app:build:mac": "npm --prefix desktop run dist:mac",
    "app:build:win": "npm --prefix desktop run dist:win",
    "app:build": "npm --prefix desktop run dist"
  }
}
